<mxfile host="app.diagrams.net"><diagram name="cay-nguoi-du-lich" id="cay-nguoi-du-lich"><mxGraphModel dx="1100" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Cây nhánh cận TSP (ví dụ giáo trình 2016, n = 6): hành trình tối ưu 1→4→6→3→5→2→1, chi phí 104" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e8c;strokeColor=#1f4e8c;fontColor=#ffffff;fontSize=16;fontStyle=1;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1060" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Gốc: cận dưới = 81&#10;chọn cạnh (6,3), β = 48" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontFamily=PT Sans;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="240" height="52" as="geometry"/></mxCell><mxCell id="c5" value="Chứa (6,3): cận 81&#10;chọn (4,6), β = 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="260" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Không chứa (6,3): cận 81 + 48 = 129&#10;✗ cắt sau khi có kỷ lục 104" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="260" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Chứa (4,6): cận 81&#10;chọn (2,1), β = 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="260" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Không chứa (4,6): cận 81 + 32 = 113&#10;✗ cắt (≥ 104)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="260" height="60" as="geometry"/></mxCell><mxCell id="c9" value="Chứa (2,1): cận 84&#10;chọn (1,4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="260" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Không chứa (2,1): cận 101 &lt; 104&#10;xét sau, không cải thiện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="260" height="60" as="geometry"/></mxCell><mxCell id="c11" value="Chứa (1,4): ma trận 2×2&#10;kết nạp (3,5),(5,2)&#10;Hành trình 104 ★ kỷ lục" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontFamily=PT Sans;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="260" height="72" as="geometry"/></mxCell><mxCell id="c12" value="chứa" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=12;fontFamily=PT Sans;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="không chứa" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=12;fontFamily=PT Sans;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="chứa" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=12;fontFamily=PT Sans;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="không chứa" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=12;fontFamily=PT Sans;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="chứa" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=12;fontFamily=PT Sans;edgeStyle=or