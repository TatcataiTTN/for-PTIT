<mxfile host="app.diagrams.net"><diagram name="dirichlet" id="dirichlet"><mxGraphModel dx="900" dy="420" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Nguyên lý Dirichlet: N vật vào k hộp ⇒ có hộp chứa ≥ ⌈N/k⌉ vật" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e8c;strokeColor=#1f4e8c;fontColor=#ffffff;fontSize=16;fontStyle=1;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="860" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Hộp 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=PT Sans;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="170" height="120" as="geometry"/></mxCell><mxCell id="c5" value="Hộp 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=PT Sans;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="170" height="120" as="geometry"/></mxCell><mxCell id="c6" value="Hộp 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=PT Sans;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="170" height="120" as="geometry"/></mxCell><mxCell id="c7" value="Hộp 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=PT Sans;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="170" height="120" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontFamily=PT Sans;opacity=70;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="26" height="26" as="geometry"/></mxCell><mxCell id="c9" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontFamily