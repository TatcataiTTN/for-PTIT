strokeColor=none;fontSize=14;fontFamily=PT Sans;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="800" height="60" as="geometry"/></mxCell><mxCell id="c18" value="Để CHẮC CHẮN có m vật cùng hộp trong k hộp cần N = k·(m − 1) + 1 vật.&#10;Ví dụ đề thi: 40 câu ⇒ 41 mức điểm; cần 12 thí sinh cùng điểm: 41·11 + 1 = 452." style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=13;fontFamily=PT Sans;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="800" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>