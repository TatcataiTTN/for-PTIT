<mxfile host="app.diagrams.net"><diagram name="cay-cai-tui" id="cay-cai-tui"><mxGraphModel dx="1100" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Cây nhánh cận: 10x₁ + 5x₂ + 3x₃ + 6x₄ → max; 5x₁ + 3x₂ + 2x₃ + 4x₄ ≤ 8 (giáo trình 2016)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e8c;strokeColor=#1f4e8c;fontColor=#ffffff;fontSize=16;fontStyle=1;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1060" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Gốc: FOPT = −∞&#10;g = 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontFamily=PT Sans;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="220" height="50" as="geometry"/></mxCell><mxCell id="c5" value="x₁ = 1: δ = 10, w = 3&#10;g = 15 → mở rộng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="150" y="160" width="230" height="60" as="geometry"/></mxCell><mxCell id="c6" value="x₁ = 0: δ = 0, w = 8&#10;g = 40/3 ≈ 13,33 ✗ cắt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="700" y="160" width="230" height="60" as="geometry"/></mxCell><mxCell id="c7" value="x₁=1, x₂=1: δ = 15, w = 0&#10;g = 15 → mở rộng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="230" height="60" as="geometry"/></mxCell><mxCell id="c8" value="x₁=1, x₂=0: δ = 10, w = 3&#10;g = 14,5 ✗ cắt (g ≤ 15)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontFamily=PT Sans;" vertex="1" parent="1"><mxGeometry x="33